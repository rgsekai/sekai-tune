rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHost(resourceData) {
      return isAuthenticated() && request.auth.uid == resourceData.hostId;
    }

    // ----------------------------------------------------
    // Public App Statistics (Install Counter)
    // ----------------------------------------------------
    match /app_stats/install_count {
      // Readable by ANY client (unauthenticated or authenticated), writeable ONLY by backend (Cloud Function / Admin SDK)
      allow read: if true;
      allow write: if false;
    }

    // ----------------------------------------------------
    // User Settings & Secrets (Feature 2)
    // ----------------------------------------------------
    match /user_settings/{userId} {
      allow read, write: if isUser(userId);
    }

    // ----------------------------------------------------
    // Public User Profiles (Profile Pictures & Display Names)
    // ----------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ----------------------------------------------------
    // User FCM Tokens (Buddy List & Push Notifications)
    // ----------------------------------------------------
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ----------------------------------------------------
    // Buddy Requests
    // ----------------------------------------------------
    match /buddy_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.fromUid != request.resource.data.toUid &&
        request.resource.data.status == "pending" &&
        request.resource.data.toUid is string &&
        request.resource.data.fromDisplayName is string;
      allow update: if false;
      allow delete: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // ----------------------------------------------------
    // Buddies List
    // ----------------------------------------------------
    match /buddies/{userId}/list/{buddyId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update, delete: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.uid == buddyId
      );
    }

    // ----------------------------------------------------
    // Together Online Sessions (Feature 1)
    // ----------------------------------------------------
    match /together_sessions/{sessionId} {
      // Must be authenticated (Anonymous Auth or Google Sign-In)
      allow read: if isAuthenticated();

      // Only authenticated clients can create a session; creator must be the host
      allow create: if isAuthenticated()
        && request.resource.data.sessionId == sessionId
        && request.resource.data.hostId == request.auth.uid;

      // Only the host can delete a session
      allow delete: if isHost(resource.data);

      // Session Updates
      allow update: if isAuthenticated() && (
        // Host has full update authority (including modifying invitedUids)
        isHost(resource.data) ||

        // Guest dismissing/declining invite (removes own UID from invitedUids)
        (
          request.resource.data.sessionId == resource.data.sessionId &&
          request.resource.data.hostId == resource.data.hostId &&
          request.resource.data.code == resource.data.code &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.active == resource.data.active &&
          request.resource.data.settings == resource.data.settings &&
          request.resource.data.playback == resource.data.playback &&
          request.resource.data.queue == resource.data.queue &&
          request.resource.data.participants == resource.data.participants &&
          !request.resource.data.get('invitedUids', []).hasAny([request.auth.uid])
        ) ||

        // Guest updates under strict independent constraints:
        (
          // 1. Immutable session metadata for guests
          request.resource.data.sessionId == resource.data.sessionId &&
          request.resource.data.hostId == resource.data.hostId &&
          request.resource.data.code == resource.data.code &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.active == resource.data.active &&
          request.resource.data.settings == resource.data.settings &&
          (
            request.resource.data.get('invitedUids', []) == resource.data.get('invitedUids', []) ||
            !request.resource.data.get('invitedUids', []).hasAny([request.auth.uid])
          ) &&

          // 2. Guests can ONLY add, update, or remove their OWN entry in the participants map
          request.resource.data.participants.diff(resource.data.participants).affectedKeys().hasOnly([request.auth.uid]) &&

          // 3. Independent Playback permission check
          (
            request.resource.data.playback == resource.data.playback ||
            resource.data.settings.allowGuestsToControlPlayback == true
          ) &&

          // 4. Independent Queue permission check
          (
            request.resource.data.queue == resource.data.queue ||
            resource.data.settings.allowGuestsToAddTracks == true
          )
        )
      );
    }
  }
}
